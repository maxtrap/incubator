# Set up

terraform {
  required_providers {
    incus = {
      source = "lxc/incus"
      version = "1.2.0"
    }
  }
}

variable "name" {
	type = string
	description = "Lab name, used as a prefix for everything the lab creates"
}

variable "image" {
  type = string
  description = "Image alias or fingerprint to build the VMs from"


  # Reinstate when resolved: https://discuss.linuxcontainers.org/t/loud-vms-stuck-in-continuous-boot-loop/27287
  # default = "images:ubuntu/26.04/cloud"
  default = "ubuntu-26.04-lab"
}


# Networking

resource "incus_network" "net1" {
	name = "${var.name}-labnet1"
	config = {
		"ipv4.address" = "none"
		"ipv6.address" = "none"
	}
}

resource "incus_network" "net2" {
	name = "${var.name}-labnet2"
	config = {
		"ipv4.address" = "none"
		"ipv6.address" = "none"
	}
}


# Profile

resource "incus_profile" "lab" {
  name = "${var.name}-lab"

  device {
    type = "disk"
    name = "root"

    properties = {
      pool = "default"
      path = "/"
    }
  }
}


# VM Instances

resource "incus_instance" "router" {
	name = "${var.name}-router"
	image = var.image
	type = "virtual-machine"
  profiles = [incus_profile.lab.name]

  # IMPORTANT: Do not change the device names.
  # The module depends on hardcoded interface names which are generated by incus alphabetically.
	device {
		name = "uplink"
		type = "nic"
		properties = {
			network = "incusbr0"
		}
	}

	device {
		name = "lan-server"
		type = "nic"

		properties = {
			network = incus_network.net1.name
			hwaddr = "02:00:00:00:00:01"
		}
	}

	device {
		name = "lan-client"
		type = "nic"

		properties = {
			network = incus_network.net2.name
			hwaddr = "02:00:00:00:00:02"
		}
	}

	config = {
		"cloud-init.network-config" = file("${path.module}/router/network.yaml")
		"cloud-init.user-data" = file("${path.module}/router/user-data.yaml")
	}
}

resource "incus_instance" "server" {
	name = "${var.name}-server"
	image = var.image
	type = "virtual-machine"
  profiles = [incus_profile.lab.name]

	device {
		name = "lan"
		type = "nic"

		properties = {
			network = incus_network.net1.name
			hwaddr = "02:00:00:00:01:01"
		}
	}

	config = {
		"cloud-init.network-config" = file("${path.module}/server/network.yaml")
	}
}

resource "incus_instance" "client" {
	name = "${var.name}-client"
	image = var.image
	type = "virtual-machine"
  profiles = [incus_profile.lab.name]

	device {
		name = "lan"
		type = "nic"

		properties = {
			network = incus_network.net2.name
			hwaddr = "02:00:00:00:02:01"
		}
	}

	config = {
		"cloud-init.network-config" = file("${path.module}/client/network.yaml")
	}
}
